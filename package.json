{
  "name": "cehnzcode",
  "version": "0.1.0",
  "description": "Mini Claude Code - extensible AI coding assistant",
  "type": "module",
  "main": "dist/index.cjs",
  "bin": {
    "cehnzcode": "dist/index.cjs"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.94.0",
    "dotenv": "^17.4.2",
    "glob": "^11.0.0",
    "minimatch": "^10.2.5",
    "openai": "^4.73.0",
    "pino": "^9.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pkg": {
    "scripts": [
      "node_modules/openai/**/*.js",
      "node_modules/@anthropic-ai/sdk/**/*.js",
      "node_modules/dotenv/**/*.js"
    ],
    "assets": [
      "node_modules/openai/**/*.json",
      "node_modules/@anthropic-ai/sdk/**/*.json"
    ]
  }
}
